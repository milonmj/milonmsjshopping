// Milon M&J Shopping — Database Schema (Stage 1)
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  BANK
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id            String    @id @default(cuid())
  name          String
  phone         String    @unique
  email         String?   @unique
  passwordHash  String
  role          Role      @default(CUSTOMER)
  addresses     Address[]
  orders        Order[]
  wishlist      WishlistItem[]
  reviews       Review[]
  createdAt     DateTime  @default(now())
}

model Address {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  label      String   // "Home", "Office"
  fullName   String
  phone      String
  district   String
  area       String
  addressLine String
  isDefault  Boolean  @default(false)
}

model Category {
  id          String     @id @default(cuid())
  nameBn      String
  nameEn      String
  slug        String     @unique
  parent      Category?  @relation("CategoryToSub", fields: [parentId], references: [id])
  parentId    String?
  children    Category[] @relation("CategoryToSub")
  products    Product[]
  isActive    Boolean    @default(true)
}

model Product {
  id              String        @id @default(cuid())
  nameBn          String
  nameEn          String
  slug            String        @unique
  descriptionBn   String
  descriptionEn   String
  sku             String        @unique
  brand           String?
  category        Category      @relation(fields: [categoryId], references: [id])
  categoryId      String

  retailPrice     Decimal
  wholesalePrice  Decimal?
  minWholesaleQty Int?          @default(0)
  discountPrice   Decimal?

  quantity        Int           @default(0)
  lowStockAlertAt Int           @default(5)
  stockStatus     StockStatus   @default(IN_STOCK)

  isFeatured      Boolean       @default(false)
  isActive        Boolean       @default(true)

  images          ProductImage[]
  variants        ProductVariant[]
  reviews         Review[]
  orderItems      OrderItem[]
  wishlistedBy    WishlistItem[]

  metaTitle       String?
  metaDescription String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String
  url       String
  sortOrder Int     @default(0)
}

model ProductVariant {
  id         String  @id @default(cuid())
  product    Product @relation(fields: [productId], references: [id])
  productId  String
  size       String?
  color      String?
  sku        String  @unique
  quantity   Int     @default(0)
  priceDelta Decimal @default(0)
}

model Review {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model WishlistItem {
  id        String  @id @default(cuid())
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String

  @@unique([userId, productId])
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  percentOff  Int?
  amountOff   Decimal?
  minOrderAmt Decimal?
  validFrom   DateTime
  validTo     DateTime
  isActive    Boolean  @default(true)
  orders      Order[]
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  user            User?         @relation(fields: [userId], references: [id])
  userId          String?
  guestName       String?
  guestPhone      String?

  items           OrderItem[]

  deliveryDistrict String
  deliveryArea     String
  deliveryAddress  String
  deliveryPhone    String

  courier         String?
  trackingNumber  String?
  deliveryCharge  Decimal       @default(0)

  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)

  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  couponId        String?
  discountAmount  Decimal       @default(0)

  subtotal        Decimal
  totalAmount      Decimal
  status          OrderStatus   @default(PENDING)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id         String  @id @default(cuid())
  order      Order   @relation(fields: [orderId], references: [id])
  orderId    String
  product    Product @relation(fields: [productId], references: [id])
  productId  String
  variantInfo String?
  quantity   Int
  unitPrice  Decimal
  isWholesale Boolean @default(false)
}

model Banner {
  id        String   @id @default(cuid())
  imageUrl  String
  linkUrl   String?
  titleBn   String?
  titleEn   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
}

model InventoryLog {
  id         String   @id @default(cuid())
  productId  String
  change     Int
  reason     String
  createdAt  DateTime @default(now())
}

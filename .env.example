# Copy this file to .env and fill in real values. Never commit .env to git.

# Database (from Neon or Supabase — free tier is enough to start)
DATABASE_URL="postgresql://user:password@host:5432/milonmj"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Image hosting (Cloudinary free tier)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# WhatsApp Business number for order links (E.164 format, e.g. 8801XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=""

